[Unit]
Description=Gunicorn daemon for PetCare Django Web Application
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/petcare
ExecStart=/home/ubuntu/petcare/venv/bin/gunicorn \
          --access-logfile - \
          --workers 3 \
          --bind unix:/home/ubuntu/petcare/petcare.sock \
          petcare_core.wsgi:application

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
